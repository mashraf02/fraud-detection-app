# Fraud Radar configuration.
# Copy to `.env` and adjust. Every value below is safe to commit except the keys.

# development | staging | production
# In production the service refuses to start unless authentication is configured,
# CORS lists exact origins, and table auto-creation is disabled.
FRAUD_RADAR_ENVIRONMENT=development

FRAUD_RADAR_LOG_LEVEL=INFO

# Postgres in production:
#   postgresql+psycopg://fraud:password@db:5432/fraud_radar
# Defaults to a local SQLite file when unset, so a fresh checkout runs with no
# infrastructure.
FRAUD_RADAR_DATABASE_URL=postgresql+psycopg://fraud:change-me@localhost:5432/fraud_radar

# Set to false in production and run `alembic upgrade head` as a deploy step.
FRAUD_RADAR_AUTO_CREATE_TABLES=false

# Directory holding fraud_model.pkl, scaler.pkl, feature_order.pkl, metadata.json
FRAUD_RADAR_MODEL_DIR=model

# Comma-separated. REQUIRED in production. Clients send these in X-API-Key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FRAUD_RADAR_API_KEYS=

# Comma-separated exact origins. Wildcards are rejected in production.
FRAUD_RADAR_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Leave unset to use the threshold recommended by the trained model
# (see GET /model for the value and its provenance).
# FRAUD_RADAR_DECISION_THRESHOLD=0.06

# Upper bound on transactions per batch request; larger batches are rejected
# with 413 rather than risking memory exhaustion.
FRAUD_RADAR_MAX_BATCH_SIZE=5000
